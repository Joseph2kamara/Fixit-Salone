PORT=4000
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
AUTO_INIT_DB=false
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=FixIt Salone Admin

# Required for real SMS phone verification (D7 Networks)
D7_API_TOKEN=

# Required for identity verification encryption: keep private and stable across deploys.
# Generate a 32-byte key, e.g. `openssl rand -hex 32`.
KYC_ENCRYPTION_KEY=

R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fixit-salone
